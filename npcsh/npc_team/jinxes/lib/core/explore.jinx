permissions:
  default: ask
jinx_name: explore
description: |
  Explore a codebase or directory using a compact, bounded agentic sub-agent.
  Builds a single prompt with the target path and task inlined, then delegates
  to the agent jinx so the LLM only receives the query it actually needs.
inputs:
  - path: null
  - task: null
  - max_turns: "10"
  - agent_turns: "10"
  - persona: null
steps:
  - name: load_instructions
    engine: python
    code: |
      import os
      from pathlib import Path
      try:
          import yaml
      except ImportError:
          yaml = None

      team_obj = context.get('team')
      instructions = ""
      try:
          if yaml:
              team_dir = None
              if team_obj and hasattr(team_obj, "source_dir") and team_obj.source_dir:
                  team_dir = team_obj.source_dir
              if not team_dir:
                  team_dir = os.path.expanduser("~/.npcsh/npc_team")
              for ctx_file in Path(team_dir).glob("*.ctx"):
                  with open(ctx_file) as f:
                      ctx = yaml.safe_load(f)
                  if ctx and "EXPLORE_INSTRUCTIONS" in ctx:
                      instructions = ctx["EXPLORE_INSTRUCTIONS"] or ""
                      break
      except Exception:
          pass
      context['explore_instructions'] = instructions
      context['output'] = ''

  - name: run_agent
    engine: agent
    query: |
      Explore the codebase at {{ path }}. This must be the full absolute path to the directory.

      {% if task %}
      Goal: {{ task }}
      {% else %}
      Goal: Explore this codebase and summarize its architecture, entry points, conventions, and key components.
      {% endif %}

      {% if context is defined and context.get('explore_instructions') %}
      Additional explore instructions: {{ context.get('explore_instructions') }}
      {% endif %}

      You have a limited turn budget. Use the first turn to list the directory and read README/config files.
      Use subsequent turns only to read key source files that clarify architecture, entry points, conventions, dependencies, and tests.
      On your final turn, stop exploring and produce a concise, well-structured report covering:
      1. Project overview
      2. Directory structure and key components
      3. Entry points and how to run/use the project
      4. Notable patterns and conventions
      5. Dependencies and testing approach (if present)

      Do not ask follow-up questions or continue exploring after producing the report.
    max_turns: "{{ max_turns | default(agent_turns) | default('10') }}"
    persona: "{{ persona | default('') }}"
